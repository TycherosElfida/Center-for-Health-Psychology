# =============================================================================
# CHP Digital Assessment Platform — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` — it is gitignored.
# =============================================================================

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# Pooled connection string from the Neon dashboard → Connection Details.
# Required by Drizzle ORM and every server-side query.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Auth.js (user-facing authentication) ──────────────────────────────────
# Random 32+ byte secret. Generate with: openssl rand -base64 32
AUTH_SECRET=REDACTED
# Public URL of the app (e.g. https://chp.example.com). Required in production.
AUTH_URL=http://localhost:3000
# Set to "true" when running behind a reverse proxy (Vercel, etc.).
AUTH_TRUST_HOST=true

# ── Google OAuth (UNUSED — placeholders only) ─────────────────────────────
# NOTE: Google sign-in is NOT implemented in this codebase. These vars are
# defined for a future Tier 2 feature but currently no code reads them.
# Leave blank or fill with placeholders; safe to omit.
GOOGLE_CLIENT_ID=REDACTED_OR_LEAVE_BLANK
GOOGLE_CLIENT_SECRET=REDACTED_OR_LEAVE_BLANK

# ── Admin JWT (separate auth system for /admin) ───────────────────────────
# Random 32+ byte secret. Distinct from AUTH_SECRET — admin auth is isolated
# from user auth by design. Generate with: openssl rand -base64 32
ADMIN_JWT_SECRET=REDACTED

# ── Optional: super_admin bootstrap (read by `pnpm db:seed`) ──────────────
# When both are set, the seed script creates a super_admin account with
# mustChangePassword=true. Safe to leave unset after first seed.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────
# REST credentials from the Upstash console → Redis database → REST API.
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=REDACTED

# ── Sentry (error monitoring + tracing) ───────────────────────────────────
# DSN from Sentry → Project Settings → Client Keys. Same value for both vars.
SENTRY_DSN=https://PUBLIC_KEY@oXXX.ingest.sentry.io/PROJECT_ID
NEXT_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@oXXX.ingest.sentry.io/PROJECT_ID
# Auth token for the Sentry build plugin (source-map upload at build time).
# Get from: Sentry → User Settings → Auth Tokens → New (scope: project:releases).
# REQUIRED during `pnpm build` and on Vercel — the build fails without it.
SENTRY_AUTH_TOKEN=REDACTED

# ── Resend (transactional email — used by report request flow) ────────────
# API key from the Resend dashboard.
RESEND_API_KEY=re_REDACTED

# ── Application encryption key (PDPL — encrypts guest emails at rest) ─────
# Random 32-byte hex string. Generate with: openssl rand -hex 32
# Rotating this invalidates all previously-encrypted guest emails. Do not
# regenerate after deployment unless you also clear `report_requests`.
ENCRYPTION_KEY=REDACTED_64_HEX_CHARS
